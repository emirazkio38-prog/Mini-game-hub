-- 8 TIC TAC TOE
games[8]=function()
 local a=arena()
 local grid=obj("Frame",a,{Position=UDim2.new(.17,0,.04,0),Size=UDim2.new(.66,0,.9,0),BackgroundTransparency=1})
 obj("UIGridLayout",grid,{CellSize=UDim2.new(.31,0,.31,0),CellPadding=UDim2.new(.035,0,.035,0)})
 local board={"","","","","","","","",""};local tiles={};local ended=false
 local wins={{1,2,3},{4,5,6},{7,8,9},{1,4,7},{2,5,8},{3,6,9},{1,5,9},{3,5,7}}
 local function won(s)
  for _,w in ipairs(wins) do if board[w[1]]==s and board[w[2]]==s and board[w[3]]==s then return true end end
  return false
 end
 local function refresh() for i,b in ipairs(tiles) do b.Text=board[i] end end
 local function play(i)
  if ended or board[i]~="" then return end
  board[i]="X";refresh()
  if won("X") then ended=true;over(a,"YOU WIN!");return end
  local empty={}
  for j=1,9 do if board[j]=="" then table.insert(empty,j) end end
  if #empty==0 then ended=true;over(a,"DRAW!");return end
  board[empty[math.random(#empty)]]="O";refresh()
  if won("O") then ended=true;over(a,"COMPUTER WINS!")
  else
   local any=false;for j=1,9 do if board[j]=="" then any=true end end
   if not any then ended=true;over(a,"DRAW!") end
  end
 end
 for i=1,9 do
  local index=i;tiles[index]=btn(grid,"",UDim2.new(),UDim2.new(1,0,1,0),C.yellow,function() play(index) end)
  tiles[index].TextColor3=C.bg;tiles[index].TextSize=28
 end
 title("TIC TAC TOE | YOU ARE X")
 controls(function() start(8) end)
end


 })
 round(a,8)

 local board=obj("Frame",a,{
  BackgroundColor3=Color3.fromRGB(34,38,80),
  BorderSizePixel=0,ZIndex=11
 })
 round(board,8)

 local cells={}
 for r=1,N do
  cells[r]={}
  for c=1,N do
   local f=obj("Frame",board,{BackgroundColor3=EMPTY,BorderSizePixel=0,ZIndex=12})
   round(f,4)
   cells[r][c]=f
  end
 end

 local slotFrames,trayPieces={},{}

 -- suara
 local function play(name,mul)
  if not soundOn or not alive then return end
  local d=SFX[name]
  if not d then return end
  local s=Instance.new("Sound")
  s.SoundId=d[1]
  s.Volume=d[2]
  s.PlaybackSpeed=d[3]*(mul or 1)
  s.Parent=gui
  s:Play()
  Debris:AddItem(s,4)
 end

 local sb
 sb=btn(area,"🔊",UDim2.new(1,-40,0,2),UDim2.fromOffset(34,26),C.panel,function()
  soundOn=not soundOn
  sb.Text=soundOn and "🔊" or "🔇"
  play("click")
 end)

 local function buildPiece(piece,size,gap,z)
  local sh=piece.shape
  local f=obj("Frame",nil,{
   BackgroundTransparency=1,ZIndex=z,
   Size=UDim2.fromOffset(sh.w*(size+gap)-gap,sh.h*(size+gap)-gap)
  })
  for _,cl in ipairs(sh.cells) do
   local c=obj("Frame",f,{
    Size=UDim2.fromOffset(size,size),
    Position=UDim2.fromOffset(cl[2]*(size+gap),cl[1]*(size+gap)),
    BackgroundColor3=piece.color,BorderSizePixel=0,ZIndex=z
   })
   round(c,4)
  end
  return f
 end

 -- logika
 local function canPlace(shape,row,col)
  for _,cl in ipairs(shape.cells) do
   local r,c=row+cl[1],col+cl[2]
   if r<1 or r>N or c<1 or c>N or grid[r][c] then return false end
  end
  return true
 end

 local function fitsAnywhere(shape)
  for r=1,N do for c=1,N do
   if canPlace(shape,r,c) then return true end
  end end
  return false
 end

 local function findLines(extra)
  local function filled(r,c) return grid[r][c] or (extra and extra[r*16+c]) end
  local rows,cols={},{}
  for r=1,N do
   local full=true
   for c=1,N do if not filled(r,c) then full=false break end end
   if full then rows[#rows+1]=r end
  end
  for c=1,N do
   local full=true
   for r=1,N do if not filled(r,c) then full=false break end end
   if full then cols[#cols+1]=c end
  end
  return rows,cols
 end

 local function renderBoard(prev)
  local extra,hl=nil,{}
  if prev then
   extra={}
   for _,cl in ipairs(prev.piece.shape.cells) do
    extra[(prev.row+cl[1])*16+prev.col+cl[2]]=true
   end
   local rows,cols=findLines(extra)
   for _,r in ipairs(rows) do for c=1,N do hl[r*16+c]=true end end
   for _,c in ipairs(cols) do for r=1,N do hl[r*16+c]=true end end
  end
  for r=1,N do for c=1,N do
   local col=grid[r][c] or EMPTY
   if prev then
    local k=r*16+c
    if extra[k] then
     col=prev.piece.color
    elseif hl[k] and grid[r][c] then
     col=grid[r][c]:Lerp(C.white,.55)
    end
   end
   cells[r][c].BackgroundColor3=col
  end end
 end

 local function renderTray()
  for i=1,3 do
   if trayPieces[i] then trayPieces[i]:Destroy() trayPieces[i]=nil end
   local p=slots[i]
   if p and slotFrames[i] then
    local size=math.min(cs*.75,(slotW*.8)/p.shape.w,(slotH*.8)/p.shape.h)
    size=math.max(8,math.floor(size))
    local f=buildPiece(p,size,2,13)
    f.AnchorPoint=Vector2.new(.5,.5)
    f.Position=UDim2.fromScale(.5,.5)
    f.Parent=slotFrames[i]
    trayPieces[i]=f
   end
  end
 end

 local function updateTitle()
  if score>blastBest then blastBest=score end
  t.Text="BLOCK BLAST | "..score.." | BEST "..blastBest
 end

 local function layout()
  local W,H=a.AbsoluteSize.X,a.AbsoluteSize.Y
  if W<20 or H<20 then return end
  local pad=6
  local landscape=W>=H*1.1
  local bsz
  if landscape then bsz=math.min(H-pad*2,W*.62) else bsz=math.min(W-pad*2,H*.64) end
  cs=math.max(10,math.floor((bsz-GAP*(N+1))/N))
  boardPx=cs*N+GAP*(N+1)
  local bx,by
  if landscape then
   bx,by=pad,(H-boardPx)/2
   slotW=math.max(40,W-boardPx-pad*3)
   slotH=math.max(40,(H-pad*4)/3)
   for i=1,3 do
    slotFrames[i].Size=UDim2.fromOffset(slotW,slotH)
    slotFrames[i].Position=UDim2.fromOffset(bx+boardPx+pad,pad+(i-1)*(slotH+pad))
   end
  else
   bx,by=(W-boardPx)/2,pad
   slotW=math.max(40,(W-pad*4)/3)
   slotH=math.max(40,H-boardPx-pad*3)
   for i=1,3 do
    slotFrames[i].Size=UDim2.fromOffset(slotW,slotH)
    slotFrames[i].Position=UDim2.fromOffset(pad+(i-1)*(slotW+pad),by+boardPx+pad)
   end
  end
  board.Position=UDim2.fromOffset(bx,by)
  board.Size=UDim2.fromOffset(boardPx,boardPx)
  for r=1,N do for c=1,N do
   local f=cells[r][c]
   f.Size=UDim2.fromOffset(cs,cs)
   f.Position=UDim2.fromOffset(GAP+(c-1)*(cs+GAP),GAP+(r-1)*(cs+GAP))
  end end
  renderTray()
 end

 local function popup(text)
  local l=obj("TextLabel",a,{
   AnchorPoint=Vector2.new(.5,.5),

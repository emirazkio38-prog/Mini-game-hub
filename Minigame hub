local blastBest=0

games[11]=function()
 local GuiService=game:GetService("GuiService")
 local TweenService=game:GetService("TweenService")
 local Debris=game:GetService("Debris")

 local N,GAP=8,3
 local EMPTY=Color3.fromRGB(48,54,104)
 local PALETTE={
  Color3.fromRGB(235,70,70),Color3.fromRGB(245,150,50),
  Color3.fromRGB(245,205,50),Color3.fromRGB(80,200,100),
  Color3.fromRGB(60,150,235),Color3.fromRGB(150,90,220),
  Color3.fromRGB(235,100,170)
 }

 -- SOUND: {id, volume, pitch}
 -- Kalau ada yang tidak bunyi, ganti id dengan "rbxassetid://NOMOR" dari Toolbox (Audio)
 local SFX={
  click={"rbxasset://sounds/switch.wav",0.6,1.0},
  pick={"rbxasset://sounds/switch.wav",0.5,1.4},
  place={"rbxasset://sounds/button.wav",0.8,0.9},
  invalid={"rbxasset://sounds/snap.mp3",0.5,0.7},
  clear={"rbxasset://sounds/electronicpingshort.wav",0.9,1.0},
  over={"rbxasset://sounds/uuhhh.mp3",0.9,1.0}
 }

 local RAW={
  {"X"},
  {"XX"},{"X","X"},
  {"XXX"},{"X","X","X"},
  {"XXXX"},{"X","X","X","X"},
  {"XXXXX"},{"X","X","X","X","X"},
  {"XX","XX"},{"XXX","XXX","XXX"},
  {"XXX","XXX"},{"XX","XX","XX"},
  {"XX","X."},{"XX",".X"},{"X.","XX"},{".X","XX"},
  {"X..","X..","XXX"},{"..X","..X","XXX"},
  {"XXX","X..","X.."},{"XXX","..X","..X"},
  {"X.","X.","XX"},{".X",".X","XX"},
  {"XX","X.","X."},{"XX",".X",".X"},
  {"XXX",".X."},{".X.","XXX"},{"X.","XX","X."},{".X","XX",".X"},
  {".XX","XX."},{"XX.",".XX"},{"X.","XX",".X"},{".X","XX","X."}
 }
 local SHAPES={}
 for _,rows in ipairs(RAW) do
  local cl={}
  for r,row in ipairs(rows) do
   for c=1,#row do
    if row:sub(c,c)=="X" then table.insert(cl,{r-1,c-1}) end
   end
  end
  table.insert(SHAPES,{cells=cl,h=#rows,w=#rows[1]})
 end

 local grid={}
 for r=1,N do
  grid[r]={}
  for c=1,N do grid[r][c]=false end
 end
 local slots={}
 local score,combo=0,0
 local busy,isOver,alive,soundOn=false,false,true,true
 local drag=nil
 local cs,boardPx=20,0
 local slotW,slotH=80,80

 local t=title("BLOCK BLAST | 0")

 -- area permainan (lebih besar dari arena biasa)
 local a=obj("Frame",area,{
  Position=UDim2.new(.02,0,.09,0),
  Size=UDim2.new(.96,0,.80,0),
  BackgroundColor3=Color3.fromRGB(26,30,62),

 local function checkGameOver()
  for i=1,3 do
   if slots[i] and fitsAnywhere(slots[i].shape) then return end
  end
  isOver=true
  task.wait(.4)
  if not alive then return end
  play("over")
  over(a,"GAME OVER\nSCORE "..score)
 end

 local function place(i,row,col)
  busy=true
  local p=slots[i]
  play("place")
  for _,cl in ipairs(p.shape.cells) do
   grid[row+cl[1]][col+cl[2]]=p.color
  end
  slots[i]=nil
  score=score+#p.shape.cells
  renderBoard()
  renderTray()

  local rows,cols=findLines()
  local n=#rows+#cols
  if n>0 then
   combo=combo+1
   local clr={}
   for _,r in ipairs(rows) do for c=1,N do clr[r*16+c]=true end end
   for _,c in ipairs(cols) do for r=1,N do clr[r*16+c]=true end end
   for k in pairs(clr) do cells[k//16][k%16].BackgroundColor3=C.white end

   -- nada makin tinggi tiap garis/combo
   local beeps=math.min(n+combo-1,6)
   for b=1,beeps do
    task.delay((b-1)*.07,function() play("clear",1+.12*(b-1)) end)
   end

   task.wait(.15)
   if not alive then return end
   for k in pairs(clr) do grid[k//16][k%16]=false end
   local gain=n*n*10+(combo-1)*10
   score=score+gain
   local txt2=""
   if n>=2 then txt2=n.." GARIS!\n" end
   txt2=txt2.."+"..gain
   if combo>1 then txt2=txt2.."\nCOMBO x"..combo end
   popup(txt2)
  else
   combo=0
  end

  renderBoard()
  updateTitle()
  if not (slots[1] or slots[2] or slots[3]) then newPieces() end
  renderTray()
  busy=false
  checkGameOver()
 end

 -- drag & drop
 local function toScreen(io)
  return Vector2.new(io.Position.X,io.Position.Y)+GuiService:GetGuiInset()
 end

 local function moveDrag(pos)
  local p=drag.piece
  local sh=p.shape
  local pw=sh.w*(cs+GAP)-GAP
  local ph=sh.h*(cs+GAP)-GAP

  -- angkatan di atas jari mengecil dekat bawah layar
  local lift=0
  if drag.touch then
   lift=math.clamp((gui.AbsoluteSize.Y-pos.Y)/2,0,cs*2)
  end

  local tlx,tly=pos.X-pw/2,pos.Y-ph/2-lift
  drag.frame.Position=UDim2.fromOffset(tlx,tly)
  drag.pos=pos

  local bp=board.AbsolutePosition
  local fc=(tlx-bp.X-GAP)/(cs+GAP)+1
  local fr=(tly-bp.Y-GAP)/(cs+GAP)+1
  local c0,r0=math.floor(fc+.5),math.floor(fr+.5)
  local bestD,bestR,bestC=1.6,nil,nil
  for dr=-1,1 do for dc=-1,1 do
   local r,c=r0+dr,c0+dc
   local dist=(fr-r)^2+(fc-c)^2
   if dist<bestD and canPlace(sh,r,c) then
    bestD,bestR,bestC=dist,r,c
   end
  end end

  local key
  if bestR then
   key=bestR..","..bestC
   drag.target={bestR,bestC}
  else
   drag.target=nil
  end
  if key~=drag.key then
   drag.key=key
   if drag.target then
    renderBoard({piece=p,row=bestR,col=bestC})
   else
    renderBoard()
   end
  end
 end

 local function startDrag(i,io)
  if drag or busy or isOver then return end
  local ty=io.UserInputType
  if ty~=Enum.UserInputType.Touch and ty~=Enum.UserInputType.MouseButton1 then return end
  local p=slots[i]
  if not p then return end
  play("pick")
  local f=buildPiece(p,cs,GAP,60)
  f.Parent=gui
  drag={slot=i,piece=p,frame=f,input=io,touch=(ty==Enum.UserInputType.Touch)}
  if trayPieces[i] then trayPieces[i].Visible=false end
  moveDrag(toScreen(io))
 end

 local function endDrag()
  local d=drag
  drag=nil
  d.frame:Destroy()
  renderBoard()
  if d.target then
   task.spawn(place,d.slot,d.target[1],d.target[2])
  else
   if trayPieces[d.slot] then trayPieces[d.slot].Visible=true end
   local p=d.pos
   if p then
    local bp,bs=board.AbsolutePosition,board.AbsoluteSize
    if p.X>bp.X and p.X<bp.X+bs.X and p.Y>bp.Y and p.Y<bp.Y+bs.Y then
     play("invalid")
    end
   end
  end
 end

 table.insert(connections,UIS.InputChanged:Connect(function(io)
  if not drag then return end
  if drag.touch then
   if io==drag.input then moveDrag(toScreen(io)) end
  elseif io.UserInputType==Enum.UserInputType.MouseMovement then
   moveDrag(toScreen(io))
  end
 end))

 table.insert(connections,UIS.InputEnded:Connect(function(io)
  if not drag then return end
  if drag.touch then
   if io==drag.input then endDrag() end
  elseif io.UserInputType==Enum.UserInputType.MouseButton1 then
   endDrag()
  end
 end))


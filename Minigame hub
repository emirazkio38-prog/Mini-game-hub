-- 1 FLAPPY BIRD
games[1]=function()
 local a=arena()
 local bird=sprite(a,.18,.45,.09,.10,"bird")
 local y,vy=.45,0
 local pipes={}
 local timer,score=0,0
 local dead=false
 local t=title("FLAPPY BIRD | 0")
 local function jump() if not dead then vy=-.85 end end
 btn(area,"TAP TO FLY",UDim2.new(.05,0,.72,0),
  UDim2.new(.9,0,0,30),C.yellow,jump)
 table.insert(connections,a.InputBegan:Connect(function(i)
  if i.UserInputType==Enum.UserInputType.Touch or
   i.UserInputType==Enum.UserInputType.MouseButton1 then jump() end
 end))
 controls(function() start(1) end)
 update=function(dt)
  if dead then return end
  vy=vy+1.55*dt;y=y+vy*dt
  bird.Position=UDim2.new(.18,0,y,0)
  timer=timer+dt
  if timer>1.4 then
   timer=0
   local g=math.random(25,48)/100
   table.insert(pipes,{x=1,g=g,
    top=box(a,1,0,.12,g-.08,C.ground),
    bot=box(a,1,g+.28,.12,1-g-.28,C.ground)})
  end
  for i=#pipes,1,-1 do
   local p=pipes[i];p.x=p.x-.42*dt
   p.top.Position=UDim2.new(p.x,0,0,0)
   p.bot.Position=UDim2.new(p.x,0,p.g+.28,0)
   if p.x<.27 and p.x+.12>.18 and
    (y<p.g-.08 or y+.1>p.g+.28) then dead=true end
   if p.x<-.15 then
    p.top:Destroy();p.bot:Destroy();table.remove(pipes,i)
    score=score+1;t.Text="FLAPPY BIRD | "..score
   end
  end
  if y<0 or y>.9 then dead=true end
  if dead then over(a,"GAME OVER\nSCORE "..score) end
 end
end

-- 2 SNAKE
games[2]=function()
 local a=arena()
 a.Size=UDim2.new(.94,0,.55,0)
 local n=12;local cells={}
 local body={{x=6,y=6},{x=5,y=6},{x=4,y=6}}
 local dir={x=1,y=0};local queued=nil;local food
 local score,elapsed=0,0;local dead=false
 local t=title("SNAKE | 0")
 for x=1,n do
  cells[x]={}
  for y=1,n do
   cells[x][y]=box(a,(x-1)/n,(y-1)/n,
    1/n-.012,1/n-.012,Color3.fromRGB(37,54,65))
  end
 end
 local function turn(x,y)
  local d=queued or dir
  if x~=-d.x or y~=-d.y then queued={x=x,y=y} end
 end

 -- FIX: D-PAD NAIK AGAR TIDAK MENUTUPI RESTART
 local dpad=obj("Frame",area,{
  Position=UDim2.new(.04,0,.58,0),
  Size=UDim2.new(.34,0,.25,0),
  BackgroundTransparency=1,ZIndex=29
 })
 local function db(text,pos,fn)
  local b=btn(dpad,text,pos,UDim2.new(.32,0,.32,0),C.yellow,fn)
  b.TextColor3=C.bg;b.TextSize=22;b.ZIndex=31
 end
 db("▲",UDim2.new(.34,0,0,0),function() turn(0,-1) end)
 db("◀",UDim2.new(0,0,.34,0),function() turn(-1,0) end)
 db("▶",UDim2.new(.68,0,.34,0),function() turn(1,0) end)
 db("▼",UDim2.new(.34,0,.68,0),function() turn(0,1) end)

 local function spawn()
  for _=1,200 do
   local f={x=math.random(n),y=math.random(n)}
   local used=false
   for _,v in ipairs(body) do
    if v.x==f.x and v.y==f.y then used=true break end
   end
   if not used then food=f return end
  end
  dead=true;over(a,"YOU WIN!")
 end
 local function draw()
  for x=1,n do for y=1,n do
   cells[x][y].BackgroundColor3=Color3.fromRGB(37,54,65)
  end end
  if food then cells[food.x][food.y].BackgroundColor3=C.red end
  for i,v in ipairs(body) do
   cells[v.x][v.y].BackgroundColor3=i==1 and C.green or C.yellow
  end
 end
 spawn();draw()
 controls(function() start(2) end)
 update=function(dt)
  if dead then return end
  elapsed=elapsed+dt;if elapsed<.18 then return end
  elapsed=elapsed-.18
  if queued then dir=queued;queued=nil end
  local h=body[1];local nx,ny=h.x+dir.x,h.y+dir.y
  if nx<1 or nx>n or ny<1 or ny>n then
   dead=true;over(a,"GAME OVER\nSCORE "..score);return
  end
  local eating=food and nx==food.x and ny==food.y
  for i,v in ipairs(body) do
   if not(i==#body and not eating) and v.x==nx and v.y==ny then
    dead=true;over(a,"GAME OVER\nSCORE "..score);return
   end
  end
  table.insert(body,1,{x=nx,y=ny})
  if eating then score=score+1;t.Text="SNAKE | "..score;spawn()
  else table.remove(body) end
  draw()
 end
end

-- 3 BRICK BREAKER
games[3]=function()
 local a=arena()
 local ball=box(a,.48,.65,.05,.06,C.yellow)
 local pad=box(a,.38,.87,.24,.06,C.green)
 local px,bx,by=.38,.5,.65;local vx,vy=.4,-.45
 local blocks={};local score=0;local dead=false
 local t=title("BRICK BREAKER | 0")
 for r=1,3 do for c=1,6 do
  table.insert(blocks,box(a,.035+(c-1)*.16,.05+(r-1)*.09,
   .13,.06,Color3.fromRGB(240-r*25,100+c*15,110)))
 end end
 local function move(dx)
  px=math.clamp(px+dx,0,.76);pad.Position=UDim2.new(px,0,.87,0)
 end
 btn(area,"◀",UDim2.new(.05,0,.78,0),UDim2.new(.25,0,0,32),C.yellow,function() move(-.08) end)
 btn(area,"▶",UDim2.new(.70,0,.78,0),UDim2.new(.25,0,0,32),C.yellow,function() move(.08) end)
 controls(function() start(3) end)
 update=function(dt)
  if dead then return end
  bx=bx+vx*dt;by=by+vy*dt
  if bx<0 then bx=0;vx=math.abs(vx) end
  if bx>.95 then bx=.95;vx=-math.abs(vx) end
  if by<0 then by=0;vy=math.abs(vy) end
  if vy>0 and by+.06>=.87 and by<=.94 and bx+.05>px and bx<px+.24 then vy=-math.abs(vy) end
  if by>.98 then dead=true;over(a,"BALL LOST") end
  for i=#blocks,1,-1 do
   local b=blocks[i];local xx=b.Position.X.Scale;local yy=b.Position.Y.Scale
   if bx+.05>xx and bx<xx+b.Size.X.Scale and by+.06>yy and by<yy+b.Size.Y.Scale then
    b:Destroy();table.remove(blocks,i);vy=-vy;score=score+1
    t.Text="BRICK BREAKER | "..score;break
   end
  end
  ball.Position=UDim2.new(bx,0,by,0)
  if #blocks==0 then dead=true;over(a,"YOU WIN!") end
 end
end


   while piece and fits(piece.shape,piece.x,piece.y+1) do
    piece.y=piece.y+1
   end
   if piece then
    lock()
    draw()
   end
  end)

 controls(function() start(10) end)
 newPiece()
 draw()

 local fall=0
 update=function(dt)
  if dead then return end
  fall=fall+dt
  if fall>.55 then
   fall=0
   move(0,1)
  end
 end
end

